# Statistiques de frequentation (webalizer) : ces pages exposent les URLs
# visitees, les adresses IP et les referents du site. Elles ne doivent jamais
# etre accessibles publiquement.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

Options -Indexes
