# Force HTTPS (compatible avec les hebergements derriere un proxy/CDN qui
# transmettent X-Forwarded-Proto plutot que la variable HTTPS directement).
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Indique aux navigateurs de ne plus jamais tenter le HTTP sur ce domaine
# (actif seulement si le navigateur recoit deja la reponse en HTTPS).
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Redirige la racine du domaine vers la page de connexion.
RewriteRule ^$ /frontend/login.php [L,R=302]
Options -Indexes

# Defense en profondeur: ces extensions ne doivent jamais etre servies
# telles quelles, ou qu'elles se trouvent dans le projet.
<FilesMatch "\.(env|sql|log|lock|ini|bak|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Defense en profondeur: aucun fichier cache (.gitignore, .git/, .env, etc.)
# ne doit jamais etre servi, meme si un dossier venait a en heberger un par
# erreur. Les .htaccess eux-memes restent proteges par Apache nativement.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
