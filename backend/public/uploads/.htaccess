# Ce dossier ne doit JAMAIS executer de code, meme si un fichier malveillant
# venait a s'y trouver malgre les controles applicatifs (whitelist + MIME).
# Toute requete sur un fichier de script echoue au lieu d'etre executee.

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|php[0-9]?|phtml|phar|pl|py|cgi|asp|aspx|sh|exe)$">
    Require all denied
</FilesMatch>

Options -ExecCGI -Indexes
AddType text/plain .php .phtml .php5 .php7

# Acces direct au fichier interdit : les telechargements passent
# obligatoirement par l'API authentifiee (/product-media/{id}/download et
# /attachments/{id}/download), qui verifie la session avant de streamer le
# fichier. Sans cette regle, ce dossier etant sous public/, une piece jointe
# restait joignable par son URL - sans aucune authentification - des que
# celle-ci fuitait (historique de navigation, copier-coller, journal proxy).
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
