# Ce dossier contient des journaux techniques (chemins de fichiers, messages
# d'erreur). Il se trouve HORS du dossier public, donc deja injoignable par
# une URL ; cette regle est une securite supplementaire si l'arborescence
# venait a etre deplacee sous la racine web.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
